{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lugus",
  "version": "0.1.0",
  "identifier": "dev.lugus.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "features": [
      "desktop"
    ]
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        {
          "identifier": "main-research",
          "windows": [
            "main"
          ],
          "permissions": [
            "allow-research"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
